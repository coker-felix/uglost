# Local development: the Vite dev server proxies nothing; the API runs on :5050.
VITE_API_URL=http://localhost:5050/api

# For the GitHub Pages production build, VITE_API_URL is injected by the GitHub
# Actions workflow from the repository variable `VITE_API_URL` (see
# .github/workflows/deploy.yml). Set it to e.g. https://your-backend.com/api

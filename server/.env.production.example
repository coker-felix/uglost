# UGLost server — production environment variables.
# Copy to .env locally, or (preferred) set these as environment variables on
# your host. The Render blueprint (render.yaml) already sets them automatically.

# Render assigns PORT automatically — do NOT set it on Render.
PORT=5050

# Point these inside a persistent disk/volume so data survives redeploys.
DATABASE_PATH=/data/uglost.sqlite
UPLOAD_DIR=/data/uploads

# Use a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

MAX_UPLOAD_MB=5

# Comma-separated list of allowed client origins, or "*" for all.
CLIENT_ORIGIN=*
